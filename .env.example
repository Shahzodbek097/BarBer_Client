# =========== BarBer_Client muhit o'zgaruvchilari ===========
# Bu faylni `.env` ga nusxalang:  cp .env.example .env
# (Lokal ishlab chiqish uchun defaults yetarli.)

# --- Asosiy ---
SECRET_KEY=dev-only-secret-key-ozgartiring
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Ma'lumotlar bazasi (docker dev compose mos) ---
DATABASE_URL=postgres://barber:barber@localhost:5432/barber_client

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/1

# --- SMS provayder (3-bosqichda ishlatiladi) ---
# console = SMS konsolga yoziladi (dev). Prod: eskiz
SMS_PROVIDER=console
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=

# --- Telegram bot (7-bosqichda ishlatiladi) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=BarBerNavbatBot
# Webhook maxfiy kaliti (bo'sh bo'lsa webhook 403 qaytaradi)
TELEGRAM_WEBHOOK_SECRET=

# --- Log darajasi ---
LOG_LEVEL=INFO
